    char* read_entire_text_file(const char* filename){
        FILE* file = fopen(filename, "r");
        if(file == NULL){
            return NULL;
        }

        char* content = __array_allocate(sizeof(char));
        content = array_reserve(content, fsize(file));
        fread(content, sizeof(char), array_capacity(content), file);
        
        return content;
    }

