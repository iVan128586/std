        content = array_reserve(content, fsize(file));
        fread(content, sizeof(byte), array_capacity(content), file);

        return content;
    }

    int64 fsize(FILE* file){
        assert(file != NULL, "huh?!");

        int64 cur = ftell(file);
        fseek(file, 0, SEEK_END);
        int64 size = ftell(file);
        fseek(file, cur, SEEK_SET);

        return size;
    }
