struct tqdm_data tqdm_data;

#ifndef __STD_NO_OS_DEPEND__
    int64 tqdm_start(int64 start){
        tqdm_data.start = start;
        tqdm_data.current = start;
        tqdm_data.start_time = set_timer();
        tqdm_data.last_render = set_timer() - 100;
        tqdm_render();
        return start;
    }

    int64 tqdm_total(int64 total){
        tqdm_data.total = total;
        tqdm_render();
        if(!(tqdm_data.current < tqdm_data.total)){
            tqdm_stop();
        }
        return total;
    }

    int64 tqdm_current(int64 current){
        tqdm_data.current = current;
        tqdm_render();
        return current;
    }

    void tqdm_print_stats(int64 done, int64 was_to_do, double elapsed_, int filled, double speed, double esti_){
        printf("\r[");
        for(int i = 0; i < filled; i++){
            printf("#");
        }
        for(int i = 0; i < TQDM_BAR_WIDTH - filled; i++){
            printf("-");
        }
        printf("] ");
        
        printf("%lld/%lld [", done, was_to_do);
        
        struct tm* elapsed = gmtime(&(time_t){elapsed_});
        if(elapsed->tm_hour){
            printf("%02d:", elapsed->tm_hour);
        }
        printf("%02d:%02d", elapsed->tm_min, elapsed->tm_sec);
        
        printf("<");
        
        if(isfinite(esti_) && !isnan(esti_)){
            struct tm* esti = gmtime(&(time_t){esti_});
            if(esti->tm_hour){
                printf("%02d:", esti->tm_hour);
            }
            printf("%02d:%02d", esti->tm_min, esti->tm_sec);
        }
        else{
            printf("??:??");
        }

        printf(", %.1fit/s]", speed);
    }

    void tqdm_render(){
        if(get_elapsed(tqdm_data.last_render) < 0.03){
            return;
        }
        tqdm_data.last_render = set_timer();
        
        double elapsed = get_elapsed(tqdm_data.start_time);
        int64 done = tqdm_data.current - tqdm_data.start;
        int64 was_to_do = tqdm_data.total - tqdm_data.start;
        
        double progress = was_to_do > 0 ? (double)done / was_to_do : 0;
        int filled = (int)(progress * TQDM_BAR_WIDTH);
        
        double speed = done / elapsed;
        
        double esti = (was_to_do - done) / speed;
        
        tqdm_print_stats(done, was_to_do, elapsed, filled, speed, esti);
    }

    void tqdm_stop(){
        printf("\r");
        for(int i = 0; i < TQDM_BAR_WIDTH + 60; i++){
            printf(" ");
        }
        printf("\r");
    }
#endif // __STD_NO_OS_DEPEND__



void* __array_create(void* buffer, int buffer_size, int data_size){
    struct array_header* header = buffer;

    void* start = &((struct array_header*)buffer)[1];
    buffer_size -= ((byte*)start - (byte*)buffer);
    assert(buffer_size > 0, "Can`t create array on this small buffer");
    buffer_size /= data_size;
    assert(buffer_size > 0, "Can`t create array on this small buffer");
    
    header->data_size = data_size;
    header->capacity = buffer_size;
    header->len = 0;
    header->is_allocated = false;
    return start;
}

#ifndef __STD_NO_OS_DEPEND__
    NO_DISCARD
    void* __array_allocate(int data_size){
        struct array_header* header = malloc(sizeof(struct array_header) + 8 * data_size);

        void* start = &header[1];

        header->data_size = data_size;
        header->capacity = 8;
        header->len = 0;
        header->is_allocated = true;
        return start;
    }


    NO_DISCARD
    void* array_reserve(void* array, int required){
        struct array_header* header = array_header(array);

        if(required <= header->capacity){
            return array;
        }
        
        assert(header->is_allocated == true, "Can`t reserve memory cause array is not allocated");
        
        int new_capacity = 1;
        for(; required > new_capacity;){
            new_capacity *= 2;
        }
        
        header = realloc(header, sizeof(struct array_header) + new_capacity * header->data_size);
        header->capacity = new_capacity;
        return &header[1];
    }

    NO_DISCARD
    void* array_make_allocated(void* array){
        struct array_header* header = array_header(array);
        
        if(header->is_allocated == true){
            return array;
        }

        void* new_array = __array_allocate(header->data_size);
        new_array = array_reserve(new_array, header->len);

        memcpy(new_array, array, header->len * header->data_size);
        return new_array;
    }

    void array_destroy(void* array){
        struct array_header* header = array_header(array);
        if(header->is_allocated){
            free(header);
        }
    }
#endif // __STD_NO_OS_DEPEND__

struct array_header* array_header(void* array){
    return &((struct array_header*)array)[-1];
}

void* array_buffer(void* array){
    return array_header(array);
}

int array_len(void* array){
    struct array_header* header = array_header(array);
    return header->len;
}

int array_capacity(void* array){
    struct array_header* header = array_header(array);
    return header->capacity;
}

int __array_append(void* array){
    struct array_header* header = array_header(array);
    assert(header->len < header->capacity, "Array is full");
    return header->len++;
}

int __array_pop(void* array){
    struct array_header* header = array_header(array);
    assert(header->len > 0, "Array is empty");
    header->len--;
    return header->len;
}

void array_clear(void* array){
    struct array_header* header = array_header(array);
    header->len = 0;
}

void __array_assign(void* array, void* data, int data_size){
    struct array_header* header = array_header(array);

    assert(data_size % header->data_size == 0, "Invalid data size?!!!!!!");
    int data_len = data_size / header->data_size;
    assert(data_len <= header->capacity, "Array is too small");
    
    header->len = data_len;
    memcpy(array, data, data_size);
}

