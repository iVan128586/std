    char* tprintf(const char* fmt, ...){
        static char result[1024];

        va_list args;
        va_start(args, fmt);

        int written = vsnprintf(result, sizeof(result), fmt, args);
        assert(written >= 0, "Formating error");
        assert(written < sizeof(result), "String is too long for tprintf");

        va_end(args);
        return result;
    }

