    void sleep_(double seconds){
        #ifdef _WIN32
            double t = set_timer();
            if((int64)(seconds * 1000 - 20) > 0){
                Sleep(seconds * 1000 - 20);
            }
            for(;;){
                if(get_elapsed(t) >= seconds){
                    break;
                }
            }
        #elif defined(__linux__)
            usleep(seconds * 1000000);
        #endif
    }

    double set_timer(){
        #ifdef _WIN32
            LARGE_INTEGER freq;
            QueryPerformanceFrequency(&freq);
            LARGE_INTEGER start;
            QueryPerformanceCounter(&start);
            return (double)start.QuadPart / freq.QuadPart;
        #elif defined(__linux__)
            struct timespec start;
            clock_gettime(CLOCK_MONOTONIC, &start);
            return start.tv_sec + start.tv_nsec / 1e9;
        #endif
    }

    double get_elapsed(double timer){
        #ifdef _WIN32
            LARGE_INTEGER freq;
            QueryPerformanceFrequency(&freq);
            LARGE_INTEGER end;
            QueryPerformanceCounter(&end);
            return ((double)end.QuadPart / freq.QuadPart) - timer;
        #elif defined(__linux__)
            struct timespec end;
            clock_gettime(CLOCK_MONOTONIC, &end);
            return (end.tv_sec + end.tv_nsec / 1e9) - timer;
        #endif
    }
#endif // __STD_NO_OS_DEPEND__







#ifndef __STD_NO_OS_DEPEND__
    char* path_resolve(const char* filename){
        #ifdef _WIN32
            static char result[MAX_PATH * 4];
            wchar_t wfilename[MAX_PATH];
            if(MultiByteToWideChar(CP_UTF8, 0, filename, -1, wfilename, MAX_PATH) == 0){
                return NULL;
            }
            wchar_t wpath[MAX_PATH];
            if(GetFullPathNameW(wfilename, MAX_PATH, wpath, NULL) >= MAX_PATH){
                return NULL;
            }
            if(WideCharToMultiByte(CP_UTF8, 0, wpath, -1, result, sizeof(result), NULL, NULL) == 0){
                return NULL;
            }

            for(int i = 0; result[i]; i++){
                if(result[i] == '\\'){
                    result[i] = '/';
                }
            }

            return result;
        #elif defined(__linux__)
            static char result[PATH_MAX * 4];

            if(realpath(filename, result) == NULL){
                return NULL;
            }

            return result;
        #endif
    }

